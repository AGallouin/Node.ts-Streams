{
  "name": "node.ts-streams",
  "version": "2.0.0",
  "description": "Typed, chainable wrapper around Node object-mode streams: backpressure, concurrency-controlled map, merge, split, batching and async iteration",
  "keywords": [
    "stream",
    "streams",
    "typescript",
    "backpressure",
    "object-mode",
    "async-iterator",
    "async-iterable",
    "pipeline",
    "map",
    "merge",
    "batch",
    "concurrency",
    "etl"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "main": "build/index.cjs",
  "module": "build/index.mjs",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.mjs",
      "require": "./build/index.cjs"
    }
  },
  "files": [
    "build"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AGallouin/Node.ts-Streams.git"
  },
  "scripts": {
    "build": "rolldown --config rolldown.config.mjs && tsc --project tsconfig.build.json --emitDeclarationOnly",
    "watch": "rolldown --watch --config rolldown.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "watch-test": "vitest",
    "prepublishOnly": "npm run build"
  },
  "author": "AGallouin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AGallouin/Node.ts-Streams/issues"
  },
  "homepage": "https://github.com/AGallouin/Node.ts-Streams#readme",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "rolldown": "^1.2.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
